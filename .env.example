# =====================================================
# .env.example — الگوی متغیرهای محیطی پروژه رابطی
# =====================================================
# این فایل را به .env در ریشهٔ پروژه کپی کنید و مقادیر را تنظیم کنید.
# فایل .env واقعی در .gitignore است و نباید commit شود.

# --- پایگاه داده ---
DB_HOST=127.0.0.1
DB_NAME=sock_b2b
DB_USER=root
DB_PASS=

# --- محیط اجرا ---
APP_ENV=local
APP_DEBUG=true

# --- آدرس سایت (در صورت نیاز به override) ---
# SITE_URL=https://jorabrabeti.ir

# ---timezone---
# APP_TIMEZONE=Asia/Tehran

# --- SMS (در صورت استفاده) ---
# SMS_PROVIDER=asa
# SMS_API_KEY=
# SMS_PATTERN_PASSWORD_RESET=
# SMS_PATTERN_ORDER_APPROVED=
# SMS_PATTERN_ORDER_SHIPPING=

# --- ایمیل (در صورت استفاده) ---
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM=
